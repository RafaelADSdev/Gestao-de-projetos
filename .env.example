# Endereços públicos
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta apenas do servidor; nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# OAuth separado do Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# Pelo menos 32 caracteres aleatórios. Não altere depois de conectar uma conta.
GOOGLE_CALENDAR_ENCRYPTION_KEY=

# Enviado automaticamente pelo Vercel Cron no header Authorization.
CRON_SECRET=
